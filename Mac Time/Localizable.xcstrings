    "pomodoro.enabled" : {
      "comment" : "Toggle label for enabling pomodoro reminders.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable Smart Pomodoro"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用智能番茄钟"
          }
        }
      }
    },
    "pomodoro.enabled.description" : {
      "comment" : "Description for enabling smart pomodoro.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, focus time will be accumulated intelligently based on your active work apps, rather than a fixed countdown."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后将根据您在工作应用中的前台活动智能累计专注时间，而非固定死板的倒计时"
          }
        }
      }
    },
    "pomodoro.action.discard" : {
      "comment" : "Menu item to discard the current pomodoro.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discard Pomodoro"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舍弃番茄"
          }
        }
      }
    },
