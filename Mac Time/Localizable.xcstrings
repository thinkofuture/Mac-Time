    "pomodoro.work_apps.description" : {
      "comment" : "Description under work apps navigation in settings.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only active usage of the selected apps below will trigger the focus timer, avoiding unrelated distractions."
